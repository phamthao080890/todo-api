# Environment – copy to .env and fill in your values
# NODE_ENV: development | production | test
NODE_ENV=development
PORT=3000

# MySQL / Sequelize
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=todo_db
DB_USER=root
DB_PASSWORD=your_password_here
# Set DB_SSL=true when connecting to a managed DB (e.g. AWS RDS, Aiven)
DB_SSL=false
# DB_CA_CERT: paste the entire CA certificate here (including -----BEGIN/END-----) for Aiven/managed databases

# JWT
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=1h

# CORS – comma-separated allowed origins; use * for development only
# Example: https://app.example.com
CORS_ORIGIN=*

# Rate limiting (auth endpoints: /api/auth/register, /api/auth/login)
# RATE_LIMIT_WINDOW_MS: sliding window in milliseconds (default: 900000 = 15 min)
# RATE_LIMIT_MAX: max requests per window per IP (default: 20)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=20

# Setup token (production only - auto-generated by Render)
# SETUP_TOKEN=your_setup_token_here
